APP_NAME="CRMC Pusbangkom"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Aplikasi ini memakai MySQL. Buat database terlebih dahulu, lalu
# sesuaikan kredensial di bawah.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=crmc_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set true di produksi yang memakai HTTPS.
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Akun admin awal (dipakai UserSeeder). Seeder memakai firstOrCreate,
# jadi akun yang sudah ada tidak diubah. Bila ADMIN_PASSWORD kosong,
# seeder membuat kata sandi acak dan menampilkannya di terminal.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# ADMIN_NAME="Administrator CRMC"
# ADMIN_NIP=199001012026011001

# Cloudflare Turnstile: verifikasi "bukan robot" di halaman login.
# PRODUCTION: isi dengan kunci asli dari dashboard Cloudflare; hostname
# domain produksi harus terdaftar di widget Turnstile.
# LOKAL/DEV: TLD .test/localhost tidak bisa didaftarkan di Cloudflare,
# pakai kunci uji resmi yang selalu lolos:
#   TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Isi bila berada di belakang reverse proxy yang meneruskan X-Forwarded-*.
TRUSTED_PROXIES=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
