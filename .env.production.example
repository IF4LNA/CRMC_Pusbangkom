# ============================================================
# Template environment PRODUKSI — CRMC Pusbangkom
#
# Salin file ini menjadi `.env` di server produksi, lalu isi semua
# nilai yang masih kosong. Jangan pernah memakai file ini apa adanya:
# APP_KEY wajib dibuat ulang dengan `php artisan key:generate`.
# ============================================================

APP_NAME="CRMC Pusbangkom"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://crmc.contoh.go.id

APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

# Log harian, bukan satu file raksasa. Pastikan storage/logs writable.
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# --- Database ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=crmc_db
DB_USERNAME=crmc
DB_PASSWORD=

# --- Sesi ---
# Wajib true bila situs disajikan lewat HTTPS.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# --- Layanan pendukung ---
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
# Aplikasi saat ini mengirim email secara langsung (tanpa antrean), jadi
# `sync` tidak membutuhkan worker. Bila nanti memakai antrean, ganti ke
# `database`/`redis` dan jalankan `php artisan queue:work` di server.
QUEUE_CONNECTION=sync
CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Email ---
# Gunakan akun surel dinas, bukan akun pribadi.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.contoh.go.id
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@contoh.go.id"
MAIL_FROM_NAME="${APP_NAME}"

# --- Akun admin awal (dipakai UserSeeder) ---
# Isi hanya saat pertama kali menyiapkan basis data. Seeder memakai
# firstOrCreate, jadi akun yang sudah ada TIDAK diubah/di-reset.
# Kosongkan ADMIN_PASSWORD agar seeder membuat kata sandi acak dan
# menampilkannya sekali di terminal.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# ADMIN_NAME="Administrator CRMC"
# ADMIN_NIP=199001012026011001

# --- Cloudflare Turnstile (wajib untuk produksi) ---
# Buat widget di dashboard Cloudflare dengan hostname domain produksi.
# Kunci uji 1x000... TIDAK BOLEH dipakai di produksi karena selalu lolos.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Reverse proxy / TLS ---
# Isi bila aplikasi berada di belakang Nginx/load balancer yang
# meneruskan header X-Forwarded-*. Contoh: 10.0.0.10 atau "*" bila
# aplikasi tidak dapat diakses langsung dari internet.
TRUSTED_PROXIES=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
